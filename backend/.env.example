# Copy to backend/.env and adjust if your setup differs. No API keys needed:
# everything runs locally.

# ---------------------------------------------------------------------------
# LLM (comprehension questions + lecture summary)
# ---------------------------------------------------------------------------
# Local Ollama server. The "/v1" suffix is kept for familiarity; the backend
# talks to Ollama's native /api/chat so it can disable model "thinking"
# (reasoning models otherwise spend their whole token budget thinking and
# return no JSON). Run `ollama serve`.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.6:35b-a3b
# Lighter alternatives if the 35B MoE is too heavy:
#   LLM_MODEL=qwen3:14b
#   LLM_MODEL=qwen3:8b

# ---------------------------------------------------------------------------
# Speech-to-text (faster-whisper, runs in-process)
# ---------------------------------------------------------------------------
# small.en keeps up with a live lecture on CPU; large-v3-turbo is more accurate
# but ~0.8x real time on CPU and falls behind. base.en is faster still.
WHISPER_MODEL=small.en
# cpu | cuda | auto   (cpu keeps all VRAM free for the LLM)
WHISPER_DEVICE=cpu
# int8 for cpu; float16 or int8_float16 for cuda
WHISPER_COMPUTE_TYPE=int8

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
